<comment>
problem   = test of the growth of the time step, in particular after a restart
configure = --prob=dt_growth_test

<job>
problem_id = DtGrowth   # problem ID: basename of output filenames

<output1>
file_type   = hst       # History data dump
dt          = 1.0e-12   # write at every cycle
data_format = %.14e     # full precision

<output2>
file_type   = rst       # Restart file; the last one is written at the end of the run
dt          = 1.0e3

<time>
cfl_number  = 0.4       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim        = -1        # cycle limit
tlim        = 1.0       # time limit
integrator  = rk2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 0         # interval for stdout summary info

<mesh>
nx1        = 64         # Number of zones in X1-direction
x1min      = -0.5       # minimum value of X1
x1max      = 0.5        # maximum value of X1
ix1_bc     = periodic   # inner-X1 boundary flag
ox1_bc     = periodic   # outer-X1 boundary flag

nx2        = 1          # Number of zones in X2-direction
x2min      = -0.5       # minimum value of X2
x2max      = 0.5        # maximum value of X2

nx3        = 1          # Number of zones in X3-direction
x3min      = -0.5       # minimum value of X3
x3max      = 0.5        # maximum value of X3

<hydro>
gamma      = 1.666666666666667 # gamma = C_p/C_v

<problem>
amp          = 0.2      # amplitude of the Gaussian bump in density and pressure
width        = 0.1      # width of the Gaussian bump
dt_small     = 1.0e-4   # user time step before dt_jump_time
dt_large     = 1.0e-1   # user time step after dt_jump_time (above the CFL limit)
dt_jump_time = 5.0e-4   # time at which the user time step changes
